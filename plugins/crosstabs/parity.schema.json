{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.crosstabs.com/schemas/codex-plugin-parity.schema.json",
  "title": "Crosstabs Codex plugin parity contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "pluginVersion",
    "verifiedAt",
    "distribution",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "pluginVersion": { "const": "0.2.4" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "distribution": {
      "type": "object",
      "required": [
        "package",
        "version",
        "requirement",
        "transport",
        "toolCount",
        "headlessToolCount",
        "headlessTools",
        "headlessResourceTemplates",
        "resourceUris",
        "registryName",
        "registryRecord"
      ],
      "properties": {
        "package": { "const": "crosstabs" },
        "version": { "const": "1.1.6" },
        "requirement": { "const": "crosstabs==1.1.6" },
        "transport": { "const": "stdio" },
        "toolCount": { "type": "integer", "minimum": 1 },
        "headlessToolCount": { "type": "integer", "minimum": 1 },
        "headlessTools": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "headlessResourceTemplates": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "resourceUris": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "registryName": { "const": "io.github.crosstabs/crosstabs" },
        "registryRecord": {
          "const": "https://registry.modelcontextprotocol.io/v0.1/servers/io.github.crosstabs%2Fcrosstabs/versions/1.1.6"
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "boundary"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": {
            "enum": ["verified", "bounded", "app-only"]
          },
          "boundary": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
